<Window x:Class="D365EntitySqlGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:D365EntitySqlGenerator.ViewModels"
        xmlns:views="clr-namespace:D365EntitySqlGenerator.Views"
        Title="D365 Entity → SQL Generator" Height="760" Width="1200"
        Background="{StaticResource WindowBrush}"
        TextElement.Foreground="{StaticResource FgBrush}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="12"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Opacity="{Binding Opacity}">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                           ToolTip="{Binding ToolTip}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- shared item template for the search dropdowns -->
        <DataTemplate x:Key="FacetItem">
            <StackPanel Margin="1">
                <TextBlock Text="{Binding EntityName}" />
                <TextBlock Foreground="{StaticResource FgMutedBrush}" FontSize="10">
                    <Run Text="{Binding Package, Mode=OneWay}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding Model, Mode=OneWay}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding RootTable, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: buttons on the LEFT of the packages directory ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Browse…" Command="{Binding BrowseFolderCommand}" MinWidth="80" />
            <Button Grid.Column="1" Content="Re-index" Command="{Binding RefreshIndexCommand}"
                    Margin="6,0,0,0" MinWidth="80" />
            <TextBlock Grid.Column="2" Text="Packages directory:" VerticalAlignment="Center"
                       Margin="14,0,8,0" Foreground="{StaticResource FgMutedBrush}" />
            <TextBlock Grid.Column="3" Text="{Binding PackagesDirectory}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PackagesDirectory}" />
        </Grid>

        <!-- ===== Main split ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: search facets + entity tree -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ToolTip="Search entities; results split into the three dropdowns below" />
                    <TextBlock Text="Search text" Foreground="{StaticResource FgMutedBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding SearchEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock Text="By entity name" Foreground="{StaticResource FgMutedBrush}" FontSize="10" />
                    <ComboBox ItemsSource="{Binding ByNameResults}" ItemTemplate="{StaticResource FacetItem}"
                              IsEnabled="{Binding SearchActive}"
                              SelectedItem="{Binding SelectedByName, Mode=TwoWay}" MaxDropDownHeight="320" Margin="0,1,0,0" />

                    <TextBlock Text="By root datasource" Foreground="{StaticResource FgMutedBrush}" FontSize="10" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding ByRootResults}" ItemTemplate="{StaticResource FacetItem}"
                              IsEnabled="{Binding SearchActive}"
                              SelectedItem="{Binding SelectedByRoot, Mode=TwoWay}" MaxDropDownHeight="320" Margin="0,1,0,0" />

                    <TextBlock Text="By datasource under root" Foreground="{StaticResource FgMutedBrush}" FontSize="10" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding ByDataSourceResults}" ItemTemplate="{StaticResource FacetItem}"
                              IsEnabled="{Binding SearchActive}"
                              SelectedItem="{Binding SelectedByDataSource, Mode=TwoWay}" MaxDropDownHeight="320" Margin="0,1,0,0" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedEntityName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Expand all" Command="{Binding ExpandAllCommand}" MinWidth="72" />
                    <Button Grid.Column="2" Content="Collapse all" Command="{Binding CollapseAllCommand}"
                            Margin="6,0,0,0" MinWidth="76" />
                </Grid>

                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TreeView ItemsSource="{Binding Tree}" BorderThickness="0">
                        <TreeView.Resources>
                            <!-- Keep the selected row dark in both focused and (un)focused states so the
                                 light node text stays readable when focus leaves the tree. -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF094771" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF1F1F1" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF094771" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF1F1F1" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" />

            <!-- Right: generated SQL -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding SelectedEntityName, TargetNullValue='Generated SQL', FallbackValue='Generated SQL'}" />
                    <Button Grid.Column="1" Content="Copy SQL" Command="{Binding CopySqlCommand}" MinWidth="82" />
                    <Button Grid.Column="2" Content="Save as" Command="{Binding SaveSqlCommand}"
                            Margin="6,0,0,0" MinWidth="82" />
                </Grid>

                <Grid Grid.Row="1">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <RichTextBox x:Name="SqlBox" IsReadOnly="True" IsDocumentEnabled="True"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     views:SqlHighlighter.Text="{Binding GeneratedSql}"
                                     Background="{StaticResource InputBrush}" Foreground="{StaticResource FgBrush}"
                                     SelectionBrush="#66FFD54A" SelectionOpacity="0.7"
                                     BorderThickness="0" Padding="6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Border>

                    <!-- Ctrl+F find bar -->
                    <Border x:Name="FindBar" Visibility="Collapsed" Panel.ZIndex="10"
                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,18,0"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="0,0,3,3" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="FindBox" Width="190" VerticalAlignment="Center"
                                     TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
                            <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="8,0"
                                       MinWidth="52" Foreground="{StaticResource FgMutedBrush}" />
                            <Button Content="▲" Click="FindPrev_Click" MinWidth="26" ToolTip="Previous (Shift+Enter)" />
                            <Button Content="▼" Click="FindNext_Click" Margin="4,0,0,0" MinWidth="26" ToolTip="Next (Enter / F3)" />
                            <Button Content="✕" Click="FindClose_Click" Margin="4,0,0,0" MinWidth="26" ToolTip="Close (Esc)" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Status ===== -->
        <Border Grid.Row="2" Background="{StaticResource ControlBrush}" Margin="0,8,0,0" Padding="8,4"
                CornerRadius="2">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgBrush}" />
        </Border>
    </Grid>
</Window>
